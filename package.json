{
  "name": "qbo-mcp",
  "version": "0.5.2",
  "description": "MCP server for QuickBooks Online API integration",
  "license": "MIT",
  "mcpName": "io.github.shawnro/qbo-mcp",
  "author": "shawnro",
  "homepage": "https://github.com/shawnro/qbo-mcp",
  "bugs": "https://github.com/shawnro/qbo-mcp/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/shawnro/qbo-mcp.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "qbo-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "build:lambda": "node scripts/build-lambda.mjs",
    "prepare": "npm run build",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "mcp",
    "quickbooks",
    "api",
    "accounting",
    "model-context-protocol"
  ],
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1108.0",
    "@aws-sdk/client-ssm": "^3.1108.0",
    "@azure/identity": "^4.6.0",
    "@azure/keyvault-secrets": "^4.9.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@napi-rs/canvas": "^0.1.100",
    "dotenv": "^17.2.3",
    "intuit-oauth": "^4.2.5",
    "jose": "^6.2.8",
    "node-quickbooks": "^2.0.50",
    "pdfjs-dist": "^5.4.624",
    "tmp": "^0.2.7"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/tmp": "^0.2.6",
    "esbuild": "^0.28.2",
    "typescript": "^5.3.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "node-quickbooks": {
      "fast-xml-parser": "5.10.1",
      "underscore": "1.13.8",
      "uuid": "11.1.1"
    }
  }
}
