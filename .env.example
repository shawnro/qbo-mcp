# QuickBooks MCP Server Configuration

# ═══════════════════════════════════════════════════════════════════════════════
# CREDENTIAL MODE
# ═══════════════════════════════════════════════════════════════════════════════
# Choose how credentials are stored:
#   - "local" (default): Store in ~/.qbo-mcp/credentials.json
#   - "aws": Use AWS Secrets Manager and SSM Parameter Store
#   - "azure": Use Azure Key Vault
# QBO_CREDENTIAL_MODE=local

# ═══════════════════════════════════════════════════════════════════════════════
# LOCAL MODE CONFIGURATION (QBO_CREDENTIAL_MODE=local or not set)
# ═══════════════════════════════════════════════════════════════════════════════
# Your QuickBooks app client credentials (from developer.intuit.com)
# QBO_CLIENT_ID=your_client_id
# QBO_CLIENT_SECRET=your_client_secret

# Optional: Custom path for credentials file (default: ~/.qbo-mcp/credentials.json)
# QBO_CREDENTIAL_FILE=/custom/path/to/credentials.json

# ═══════════════════════════════════════════════════════════════════════════════
# AWS MODE CONFIGURATION (QBO_CREDENTIAL_MODE=aws)
# ═══════════════════════════════════════════════════════════════════════════════
# AWS credentials are loaded from environment or ~/.aws/credentials
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-2

# QuickBooks credentials stored in AWS Secrets Manager
# Secret should contain JSON: { client_id, client_secret, access_token, refresh_token, redirect_url }
QBO_SECRET_NAME=prod/qbo

# Company ID stored in SSM Parameter Store
QBO_COMPANY_ID_PARAM=/prod/qbo/company_id

# ═══════════════════════════════════════════════════════════════════════════════
# AZURE MODE CONFIGURATION (QBO_CREDENTIAL_MODE=azure)
# ═══════════════════════════════════════════════════════════════════════════════
# Azure identity is resolved via DefaultAzureCredential (managed identity, CLI, env vars, etc.)

# Key Vault URI (required for Azure mode)
# AZURE_KEY_VAULT_URL=https://myvault.vault.azure.net

# Secret name for QBO credentials JSON (default: qbo-credentials)
# The secret should contain JSON: { client_id, client_secret, access_token, refresh_token, redirect_url, company_id }
# QBO_SECRET_NAME=qbo-credentials

# Fallback company ID if not included in the Key Vault secret
# QBO_COMPANY_ID=your_company_id

# ═══════════════════════════════════════════════════════════════════════════════
# OPTIONAL SETTINGS
# ═══════════════════════════════════════════════════════════════════════════════
# Use QuickBooks sandbox environment (default: false / production)
# QBO_SANDBOX=true

# Maximum time to wait for a node-quickbooks callback (default: 60000 ms).
# Must be an integer from 1 to 600000. Hosted deployments should set this
# below their platform request timeout.
# QBO_REQUEST_TIMEOUT_MS=60000

# ═══════════════════════════════════════════════════════════════════════════════
# HOSTED HTTP / LAMBDA CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════
# Required canonical public base URL for every hosted deployment. Include an API
# Gateway stage path when applicable. Hosted URLs are never derived from Host.
# MCP_PUBLIC_BASE_URL=https://mcp.example.com
# MCP_PUBLIC_BASE_URL=https://abc123.execute-api.us-east-2.amazonaws.com/prod

# JWT resource-server validation. Set all three values to enable authentication.
# Partial configuration is rejected; authentication never disables implicitly.
# MCP_AUTH_JWKS_URI=https://login.microsoftonline.com/<tenant>/discovery/v2.0/keys
# MCP_AUTH_AUDIENCE=api://your-application-id
# MCP_AUTH_ISSUER=https://login.microsoftonline.com/<tenant>/v2.0
# MCP_AUTH_SCOPE=access_as_user

# OAuth authorization-server proxy used by MCP clients for interactive login.
# This is separate from JWT validation and requires enabled authentication.
# MCP_AUTH_SERVER_URL=https://login.microsoftonline.com/<tenant>/v2.0
# MCP_RESOURCE_NAME=QuickBooks MCP Server

# Explicit development-only anonymous hosted mode. Do not combine this with any
# MCP_AUTH_* JWT or OAuth values. OAuth discovery/proxy routes are disabled.
# MCP_AUTH_DISABLED=true

# ═══════════════════════════════════════════════════════════════════════════════
# MULTI-COMPANY PROFILES (optional)
# ═══════════════════════════════════════════════════════════════════════════════
# Path to a JSON profiles config file for multi-company support.
# Default: ~/.qbo-mcp/profiles.json
# If this file exists, it overrides QBO_CREDENTIAL_MODE and enables
# list_qbo_profiles / switch_qbo_profile tools.
# QBO_PROFILES_FILE=~/.qbo-mcp/profiles.json

# Optional attachment roots for single-company mode. Use the platform path
# delimiter (semicolon on Windows, colon on Linux/macOS). Multi-company setups
# should configure upload_roots inside each profile instead.
# QBO_UPLOAD_ROOTS=C:\Accounting\Business A\AP;C:\Accounting\Business A\Receipts
